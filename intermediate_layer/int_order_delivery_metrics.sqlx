config {
    type: "view",
    schema: "intermediate"
}

SELECT
    order_id,
    DATE_DIFF(DATE(order_delivered_customer_date), DATE(order_purchase_date), DAY) AS delivery_days,
    CASE 
        WHEN DATE(order_delivered_customer_date) > DATE(order_estimated_delivery_date) THEN TRUE
        ELSE FALSE
    END AS is_late_delivery
FROM
    ${ref("stg_orders")}
WHERE
    order_delivered_customer_date IS NOT NULL
