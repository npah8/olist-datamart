config {
    type: "view",
    schema: "staging",
    description: "Chuẩn hóa chi tiết sản phẩm trong đơn"
}

SELECT
    order_id,
    order_item_id,
    product_id,
    seller_id,
    CAST(price AS FLOAT64) AS price,
    CAST(freight_value AS FLOAT64) AS freight_value
FROM
    `inspiring-keel-513202-g8.olist.olist_order_items_dataset`
